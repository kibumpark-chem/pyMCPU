"""The CPU baseline this build of ``pymcpu.mcpu_core`` needs.

Generated by CMake from cmake/_build_arch.py.in; do not edit. ``pymcpu``
reads it before it loads the extension (see ``pymcpu._cpu_check``).
"""

#: "v2", "v3" or "v4" for an x86-64 baseline build, "none" when the build
#: names no fixed instruction set (MCPU_ARCH native, none, a raw -march value,
#: or a Debug build).
TIER = "@MCPU_CPU_BASELINE_TIER@"
#: The -march value the extension was compiled with ("" for none).
MARCH = "@MCPU_ARCH_MARCH@"
#: MCPU_ARCH as given to CMake.
REQUESTED = "@MCPU_ARCH@"
