cff-version: 1.2.0
title: "pyMCPU: Monte Carlo protein folding with knowledge-based potentials"
message: "If you use pyMCPU in published work, please cite it."
type: software
authors:
  - family-names: Park
    given-names: Kibum
    email: kibum_park@fas.harvard.edu
    affiliation: "Shakhnovich Laboratory, Harvard University"
version: 0.1.0
# Set to the release day as the last step before tagging (CONTRIBUTING.md,
# "Making a release"); wheels.yml refuses to publish while this placeholder
# is here.
date-released: "2026-10-11"
# No `license` key: CFF reads a list of licences as alternatives (OR), but the
# package is MIT AND five third-party licences (README, "License").
repository-code: "https://github.com/kibumpark-chem/pyMCPU"
url: "https://pymcpu.readthedocs.io"
keywords:
  - monte-carlo
  - protein-folding
  - molecular-simulation
  - knowledge-based-potentials
  - computational-biophysics
# NOTE: no `doi:` yet. Zenodo mints DOIs only when a GitHub release is
# published, so the concept DOI exists only after the first GitHub release.
# Switch the repository on in Zenodo before creating that release (otherwise
# the first archived DOI belongs to 0.1.1, not to the release people will
# cite), then add the concept DOI here.
